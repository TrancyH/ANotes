<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面图标长按快捷方式(docs/01 §2.2 外部进入):经 shortcut extra → MainActivity → __shortcut -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="create"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_add"
        android:shortcutShortLabel="@string/shortcut_create"
        android:shortcutLongLabel="@string/shortcut_create">
        <intent
            android:action="com.amoolink.notes.action.CREATE"
            android:targetPackage="com.amoolink.notes"
            android:targetClass="com.amoolink.notes.MainActivity">
            <extra android:name="shortcut" android:value="create" />
        </intent>
    </shortcut>
    <shortcut
        android:shortcutId="search"
        android:enabled="true"
        android:icon="@android:drawable/ic_menu_search"
        android:shortcutShortLabel="@string/shortcut_search"
        android:shortcutLongLabel="@string/shortcut_search">
        <intent
            android:action="com.amoolink.notes.action.SEARCH"
            android:targetPackage="com.amoolink.notes"
            android:targetClass="com.amoolink.notes.MainActivity">
            <extra android:name="shortcut" android:value="search" />
        </intent>
    </shortcut>
</shortcuts>
