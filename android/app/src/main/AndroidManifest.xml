<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- P1 提醒:通知(Android 13+ 运行时申请)与精确闹钟(特殊权限,未授权时降级 setWindow) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <application
        android:label="AmooNotes"
        android:icon="@android:drawable/ic_menu_edit"
        android:theme="@android:style/Theme.Material.Light.NoActionBar"
        android:allowBackup="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- P1 分享接收:系统分享菜单 → __shareReceived 新建笔记(docs/01 §3.5) -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- 图标长按快捷方式:新建/搜索(res/xml/shortcuts.xml) -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- P1 提醒:闹钟到期发通知(exported=false,仅自家 PendingIntent 触发) -->
        <receiver
            android:name=".ReminderReceiver"
            android:exported="false" />
    </application>

</manifest>
